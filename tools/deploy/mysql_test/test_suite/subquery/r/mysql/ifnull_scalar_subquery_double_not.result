create table t_ifnull_double_not (id int primary key, n tinyint, s varchar(10));
insert into t_ifnull_double_not values (1, 0, 'x'), (2, 1, 'y'), (3, NULL, 'x'), (4, NULL, 'y'), (5, NULL, NULL);
SELECT id FROM t_ifnull_double_not WHERE IFNULL((SELECT FALSE), !(!(s LIKE 'x'))) ORDER BY id;
id
