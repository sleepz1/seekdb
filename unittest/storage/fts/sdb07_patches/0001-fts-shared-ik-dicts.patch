+int get_ik_shared_dicts(ObFTDictHub &hub, ObIKSharedDicts *&shared)
+{
+  int ret = OB_SUCCESS;
+  shared = ATOMIC_LOAD(&g_ik_shared_dicts);
+  if (OB_ISNULL(shared)) {
