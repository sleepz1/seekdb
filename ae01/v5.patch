+  for (int t = threadIdx.x; t < SK_SEL_CAP; t += blockDim.x) {
+    if (t < K) { kd[t] = rsd[t]; ki[t] = rsi[t]; } else { kd[t] = INFINITY; ki[t] = 0xffffffffu; }
+  }
+  if (threadIdx.x == 0) { cnt = K; thr = rsd[K - 1]; }
+  __syncthreads();
+  const int limit = SK_SEL_CAP - SK_SEL_THREADS;
